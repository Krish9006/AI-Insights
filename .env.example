# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Neon: use connection string with sslmode=require)  
DATABASE_URL=

# Set to false only for local Postgres without TLS
DATABASE_SSL=true

# Set to false in production after you have migrations (recommended)
DATABASE_SYNCHRONIZE=true

JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Required for /users/chat (Groq)
GROQ_API_KEY=

# Server port (default 5000)
# PORT=5000
